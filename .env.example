# Razorpay (Settings → API Keys in the Razorpay dashboard)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Settings → Webhooks → set a secret when you add the webhook URL below
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Discord bot (Discord Developer Portal → your app → Bot → token)
# The bot needs the "Manage Roles" permission and must sit ABOVE the roles it assigns
DISCORD_BOT_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DISCORD_GUILD_ID=1521192076765822996
# Map each shop item id to the Discord role id it should grant
DISCORD_ROLE_CUSTOM_COLOUR=000000000000000000
DISCORD_ROLE_REGULAR_BADGE=000000000000000000
DISCORD_ROLE_VIP_VOICE=000000000000000000

# Where the frontend is served from, for CORS
FRONTEND_ORIGIN=http://localhost:8080

PORT=3000
